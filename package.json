{
  "name": "rustdesk-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm --filter web dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write apps/web/src packages/ui/src",
    "format:check": "prettier --check apps/web/src packages/ui/src"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^24.15.0"
  }
}
